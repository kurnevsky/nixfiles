# Guest NixOS system run by plasma-sandbox. Only its /etc, system path and
# graphics drivers are used: nothing is activated and no services run, so the
# session talks to the host only through the sockets the launcher binds.
{ lib, pkgs, ... }:

let
  # Bound by the launcher, see `plasma-sandbox --set-lock-password`.
  lockPassword = "/etc/plasma-sandbox/lock-password";
  # pam_exec passes the password on stdin, terminated by NUL. It runs the
  # script with PAM's environment only, without PATH, so there are only
  # builtins and absolute paths.
  checkLockPassword = pkgs.writeShellScript "check-lock-password" ''
    IFS= read -r -d "" password || true
    hash="$(< ${lockPassword})" || exit 1
    salt="''${hash#\$6\$}"
    salt="''${salt%%\$*}"
    [ "$(printf '%s' "$password" | ${pkgs.openssl}/bin/openssl passwd -6 -salt "$salt" -stdin)" = "$hash" ]
  '';
in

{
  boot.isContainer = true;

  networking = {
    hostName = "sandbox";
    useDHCP = false;
  };

  hardware.graphics.enable = true;

  documentation.nixos.enable = false;

  services.desktopManager.plasma6.enable = true;
  # There is no systemd user instance to start the session with.
  environment.etc."xdg/startkderc".text = ''
    [General]
    systemdBoot=false
  '';

  # The lock screen can't use pam_unix, which needs the suid unix_chkpwd and
  # the real password hashes, so it checks a password of its own instead.
  security.pam.services.kde.text = lib.mkForce ''
    auth required ${pkgs.pam}/lib/security/pam_exec.so quiet expose_authtok ${checkLockPassword}
    account required ${pkgs.pam}/lib/security/pam_permit.so
    password required ${pkgs.pam}/lib/security/pam_deny.so
    session required ${pkgs.pam}/lib/security/pam_permit.so
  '';

  # passwd and group are generated by the launcher and there is no nscd, so
  # only files work.
  environment.etc."nsswitch.conf".text = lib.mkForce ''
    passwd: files
    group: files
    shadow: files
    hosts: files dns
    networks: files
    ethers: files
    services: files
    protocols: files
    rpc: files
  '';
}
